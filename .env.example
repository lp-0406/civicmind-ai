# CivicMind AI - local environment template
#
# Usage:
#   Windows PowerShell:  Copy-Item .env.example .env
#   POSIX shells:        cp .env.example .env
#
# RULES
#   * `.env` is git-ignored. Never commit real credentials.
#   * `.env.example` is safe to commit because it contains NO real values.
#   * The application reads secrets from environment variables only; values
#     placed in `.env` are loaded into the process environment at startup.
#   * Never hardcode credentials in source code, configs, notebooks or docs.

# Runtime environment: development | testing | staging | production
CIVICMIND_ENV=development

# Logging: level (DEBUG|INFO|WARNING|ERROR|CRITICAL) and format (text|json)
CIVICMIND_LOG_LEVEL=INFO
CIVICMIND_LOG_FORMAT=text

# Filesystem locations (relative paths resolve against the project root)
CIVICMIND_DATA_DIR=data
CIVICMIND_LOGS_DIR=logs
CIVICMIND_ARTIFACTS_DIR=artifacts
CIVICMIND_CONFIGS_DIR=configs

# Optional: pin the project root explicitly (useful in CI or containers)
# CIVICMIND_PROJECT_ROOT=/absolute/path/to/civicmind-ai

# ---------------------------------------------------------------------------
# AI / decision-support layer
# ---------------------------------------------------------------------------
# Provider selection: auto | deterministic | local | api
#   auto           prefer a configured local model, then an API model, else deterministic
#   deterministic  template-only; always available, no model and no network
#   local          a Hugging Face text-generation model on CPU or CUDA
#   api            an OpenAI-compatible chat-completions endpoint
# The deterministic fallback is always available, so the pipeline never needs a
# model, a GPU or an API key to answer a question.
CIVICMIND_AI_PROVIDER=auto

# Local model identifier (Hugging Face id or a local directory). Empty = not configured.
# Never a machine-specific absolute path. Example (downloads at deploy time, not now):
#   CIVICMIND_AI_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
CIVICMIND_AI_MODEL_ID=

# Device: auto | cpu | cuda | cuda:0 | mps. 'auto' uses CUDA when available, else CPU.
CIVICMIND_AI_DEVICE=auto

# Generation controls
CIVICMIND_AI_MAX_NEW_TOKENS=512
CIVICMIND_AI_TEMPERATURE=0.0

# OpenAI-compatible API backend (only used when CIVICMIND_AI_PROVIDER selects it)
CIVICMIND_AI_API_BASE_URL=
CIVICMIND_AI_API_KEY_ENV=CIVICMIND_AI_API_KEY
CIVICMIND_AI_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Add real credentials here (or export them in your shell) once integrations
# exist. Leave values empty until then. Access them with
# `civicmind.config.get_secret(...)`; they are never logged or persisted.
#
# CIVICMIND_EXAMPLE_API_KEY=
# CIVICMIND_AI_API_KEY=
