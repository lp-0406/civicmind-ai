# CivicMind AI - local environment template
#
# Usage:
#   Windows PowerShell:  Copy-Item .env.example .env
#   POSIX shells:        cp .env.example .env
#
# RULES
#   * `.env` is git-ignored. Never commit real credentials.
#   * `.env.example` is safe to commit because it contains NO real values.
#   * The application reads secrets from environment variables only; values
#     placed in `.env` are loaded into the process environment at startup.
#   * Never hardcode credentials in source code, configs, notebooks or docs.

# Runtime environment: development | testing | staging | production
CIVICMIND_ENV=development

# Logging: level (DEBUG|INFO|WARNING|ERROR|CRITICAL) and format (text|json)
CIVICMIND_LOG_LEVEL=INFO
CIVICMIND_LOG_FORMAT=text

# Filesystem locations (relative paths resolve against the project root)
CIVICMIND_DATA_DIR=data
CIVICMIND_LOGS_DIR=logs
CIVICMIND_ARTIFACTS_DIR=artifacts
CIVICMIND_CONFIGS_DIR=configs

# Optional: pin the project root explicitly (useful in CI or containers)
# CIVICMIND_PROJECT_ROOT=/absolute/path/to/civicmind-ai

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Add real credentials here (or export them in your shell) once integrations
# exist. Leave values empty until then. Access them with
# `civicmind.config.get_secret(...)`; they are never logged or persisted.
#
# CIVICMIND_EXAMPLE_API_KEY=
